flow "circio_code_review" {

  goal: "Analyseer codewijzigingen en geef constructieve feedback op kwaliteit, leesbaarheid, performance en security risico's."

  context {
    repo        = "https://github.com/project/circio"
    guidelines  = ["docs/coding-standards.md", "docs/security.md"]
    language    = "mixed"
  }

  inputs {
    target_files
    review_focus
    strictness_level
  }

  requires {
    skills: ["code_review"]
    apply_to: ["primary", "secondary"]
  }

  routing {
    when (review_focus == "security" or review_focus == "performance")
         and strictness_level == "high"
      -> secondary "bug_triage_agent"

    when review_focus == "security"
      -> primary "bug_triage_agent"

    when review_focus == "readability"
      -> primary "code_review_agent"

    default -> fallback "generalist_agent"
  }

  explain {
    enabled: "true"
    level: "detailed"
    include: ["matched_rule", "evaluated_conditions", "selected_agent", "skill_checks", "rejected_rules"]
    style: "human"
  }

  agents {
    primary: "code_review_agent"
    secondary: "bug_triage_agent"
    fallback: "generalist_agent"
  }

  steps {
    1: load_code_changes
    2: analyze_structure
    3: detect_code_smells
    4: check_best_practices
    5: identify_risks
    6: generate_review_summary
  }

  constraints {
    - "Pas geen code automatisch aan."
    - "Wees duidelijk over ernst (bijv. 'laag risico', 'hoog risico')."
    - "Respecteer bestaande architectuurkeuzes."
    - "Geef feedback als suggesties, niet als verplichtingen."
  }
}

